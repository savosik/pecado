[mysqld]
# Конфиг основной БД, общий для локалки и прода. До его появления сервис `mysql`
# работал на голых дефолтах образа mysql:8.0 — то есть поведение бинлога и памяти
# было не выбрано, а получено по умолчанию.
#
# Прод-специфичные значения (буфер под реальный объём данных) — в prod.cnf,
# он подключается только через docker-compose.prod.yml и перекрывает этот файл.

# === Buffer Pool ===
# Значение для разработки: локальной базе большего не нужно, а машина не резиновая.
# На проде перекрывается в prod.cnf.
innodb_buffer_pool_size         = 256M
innodb_buffer_pool_instances    = 1

# === Binary Log ===
# Бинлог нужен ровно для одного — PITR: суточный дамп в 03:00 + накат журнала
# до момента аварии. Реплик у нас нет и не планируется.
log_bin                         = binlog
binlog_format                   = ROW
server_id                       = 1

# 3 суток вместо дефолтных 30. Замер на проде 2026-07-16: журнал рос по ~240 MB
# в сутки и занял 5.55 GB при 1.45 GB самих данных — в 3.8 раза больше базы,
# и всё это впустую, потому что бэкап его не забирал.
# Трёх суток хватает пережить выходные, если ночной бэкап упал в пятницу.
# Дольше держать незачем: журнал старше последнего дампа для PITR бесполезен.
binlog_expire_logs_seconds      = 259200
binlog_expire_logs_auto_purge   = ON

# Очистка оценивается в момент ротации файла. С дефолтным 1G на спокойной базе
# ротация редкая, и файлы переживают свой срок хранения (на проде лежали логи
# за 23 дня при сроке 30 — просто не наступал повод ротировать). 256M = ротация
# чаще, очистка точнее, потолок предсказуемее.
max_binlog_size                 = 256M

# Жёсткого потолка на суммарный объём в 8.0 нет: binlog_space_limit появился
# только в 8.4. Страховка — /srv/scripts/binlog-guard.sh (cron каждые 15 минут).

# === Character Set ===
character-set-server            = utf8mb4
collation-server                = utf8mb4_unicode_ci

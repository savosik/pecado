# docker/nginx/prod-https.conf.example
#
# Финальный production-конфиг с HTTPS.
#
# Применяется ПОСЛЕ получения SSL-сертификата через certbot:
#   1. Остановить nginx: `cd /srv/pecado && sg docker -c "docker compose -f docker-compose.yml -f docker-compose.prod.yml stop nginx"`.
#   2. Получить cert: `sudo certbot certonly --standalone -d pecado.ru -d www.pecado.ru`.
#   3. Скопировать этот файл на место `prod.conf`:
#      `cp docker/nginx/prod-https.conf.example docker/nginx/prod.conf`.
#   4. Закоммитить в main → авто-деплой через CI задеплоит новый конфиг и поднимет nginx.
#
# Renew hook (для перезагрузки nginx после автообновления cert):
#   /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh:
#     #!/bin/bash
#     cd /srv/pecado && sg docker -c "docker compose -f docker-compose.yml -f docker-compose.prod.yml exec -T nginx nginx -s reload"

# ── HTTP → HTTPS redirect ──────────────────────────────────────────────
server {
    listen 80;
    server_name pecado.ru www.pecado.ru;

    # ACME challenge должен работать по HTTP даже после получения cert (для renew)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Всё остальное — редирект на HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS server ───────────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    server_name pecado.ru www.pecado.ru;

    # SSL
    ssl_certificate /etc/letsencrypt/live/pecado.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pecado.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss:;" always;

    # Основные настройки
    index index.php index.html;
    client_max_body_size 100M;
    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;
    root /var/www/public;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_buffering off;
        fastcgi_read_timeout 60;
    }

    # ── AsyncAPI документация ──────────────────────────────────────────
    location ^~ /docs/erp/spec.yaml {
        alias /var/www/docs/asyncapi/pecado-erp-bundled.yaml;
        default_type "text/yaml; charset=utf-8";
    }

    location ^~ /docs/erp/schemas/ {
        alias /var/www/app/Services/Erp/Schemas/;
        default_type "application/json; charset=utf-8";
        autoindex on;
    }

    location ^~ /docs/erp/ {
        alias /var/www/docs/asyncapi/html/;
        index index.html;
    }

    # ── MkDocs ─────────────────────────────────────────────────────────
    location ^~ /docs/erp-guide/ {
        alias /var/www/docs-erp/site/;
        index index.html;
    }

    location ^~ /docs/test-plan/ {
        alias /var/www/docs-testing/site/;
        index index.html;
    }

    # ── Длинные синхронные экспорты ───────────────────────────────────
    location ^~ /export/ {
        try_files $uri @export_php;
    }

    location @export_php {
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_buffering off;
        fastcgi_read_timeout 300s;
        fastcgi_send_timeout 300s;
    }

    # ── Laravel default ────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.php?$query_string;
        gzip_static on;
    }

    # ── Статика с долгим кешем ────────────────────────────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        log_not_found off;
    }

    # ── Защита от прямого доступа к чувствительным файлам ─────────────
    location ~ /\. {
        deny all;
    }

    location ~* (\.env|composer\.(json|lock)|package(-lock)?\.json|webpack\.mix\.js|artisan)$ {
        deny all;
    }
}

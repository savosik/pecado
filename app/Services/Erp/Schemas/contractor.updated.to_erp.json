{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "contractor.updated.to_erp",
    "title": "contractor.updated (Сайт → 1С)",
    "description": "Обновление контрагента на сайте — отправка данных в 1С. Публикуется при изменении значимых полей уже синхронизированной Company (имеющей erp_id) либо при изменении её банковских реквизитов. Поле `uuid` — это Company.erp_id, выданный 1С при первичной выгрузке.",
    "type": "object",
    "properties": {
        "event": {
            "type": "string",
            "const": "contractor.updated",
            "description": "Тип события. Всегда «contractor.updated». Ограничено константой в v15.16.0: до этого поле принимало любую строку, и сообщение с чужим event проходило бы валидацию этой схемы."
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "uuid": {
            "type": "string",
            "format": "uuid",
            "description": "UUID контрагента в 1С (Company.erp_id). Обязательное — без него 1С не сможет сматчить контрагента."
        },
        "partner_uuid": {
            "type": "string",
            "format": "uuid",
            "description": "UUID партнёра-владельца. Обязательный — без него 1С не сможет привязать контрагента."
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "legal_name": {
            "type": [
                "string",
                "null"
            ]
        },
        "tax_id": {
            "type": "string",
            "description": "Налоговый идентификатор контрагента (ИНН / УНП / БИН и т.д.)",
            "minLength": 1
        },
        "tax_code": {
            "type": [
                "string",
                "null"
            ]
        },
        "registration_number": {
            "type": [
                "string",
                "null"
            ]
        },
        "okpo_code": {
            "type": [
                "string",
                "null"
            ]
        },
        "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
        },
        "legal_address": {
            "type": [
                "string",
                "null"
            ]
        },
        "actual_address": {
            "type": [
                "string",
                "null"
            ]
        },
        "phone": {
            "type": [
                "string",
                "null"
            ]
        },
        "email": {
            "type": [
                "string",
                "null"
            ]
        },
        "bank_accounts": {
            "type": [
                "array",
                "null"
            ],
            "items": {
                "type": "object",
                "properties": {
                    "bank_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "bank_bik": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "correspondent_account": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "account_number": {
                        "type": "string",
                        "minLength": 1
                    },
                    "is_primary": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid",
        "partner_uuid",
        "tax_id",
        "name",
        "country"
    ]
}

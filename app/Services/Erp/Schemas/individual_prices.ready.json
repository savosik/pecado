{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "individual_prices.ready",
    "title": "individual_prices.ready (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "upload_type": {
            "type": "string"
        },
        "partner_uuid": {
            "type": "string",
            "format": "uuid"
        },
        "file_url": {
            "type": "string",
            "minLength": 1
        },
        "records_count": {
            "type": "integer",
            "minimum": 0
        },
        "timestamp": {
            "type": "string"
        }
    },
    "additionalProperties": true,
    "required": [
        "event"
    ]
}

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "individual_prices.ready",
    "title": "individual_prices.ready (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string",
            "description": "Тип события. Всегда «individual_prices.ready». Ограничено константой в v15.16.0: до этого поле принимало любую строку, и сообщение с чужим event проходило бы валидацию этой схемы.",
            "const": "individual_prices.ready"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "upload_type": {
            "type": "string"
        },
        "partner_uuid": {
            "type": "string",
            "format": "uuid"
        },
        "file_url": {
            "type": "string",
            "minLength": 1
        },
        "records_count": {
            "type": "integer",
            "minimum": 0
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "file_url",
        "upload_type",
        "partner_uuid"
    ]
}

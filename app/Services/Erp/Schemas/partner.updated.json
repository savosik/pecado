{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "partner.updated.from_erp",
    "title": "partner.updated (1С → Сайт)",
    "description": "Обновление атрибутов существующего партнёра. Все поля кроме event, message_id, uuid — опциональны (частичное обновление).",
    "type": "object",
    "properties": {
        "event": {
            "type": "string",
            "description": "Тип события. Всегда «partner.updated». Ограничено константой в v15.16.0: до этого поле принимало любую строку, и сообщение с чужим event проходило бы валидацию этой схемы.",
            "const": "partner.updated"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "login": {
            "type": "string",
            "minLength": 1
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "phone": {
            "type": [
                "string",
                "null"
            ]
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "city": {
            "type": [
                "string",
                "null"
            ]
        },
        "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
        },
        "is_active": {
            "type": "boolean"
        },
        "client_status": {
            "type": [
                "string",
                "null"
            ]
        },
        "reserve_allowed": {
            "type": [
                "boolean",
                "null"
            ],
            "description": "Участник режима «Заказы в резерве» (v16.9.0, топик №5 Agent Hub). Мастер флага — 1С (отдельный реквизит партнёра): сайт показывает выбор резерва в чекауте только участникам и может точечно сузить охват на своей стороне, но не расширить. Отсутствие поля и null означают «признак не меняется»."
        },
        "manager": {
            "type": [
                "object",
                "null"
            ],
            "properties": {
                "uuid": {
                    "type": "string",
                    "description": "UUID пользователя-менеджера в 1С (Справочник «Пользователи»)"
                },
                "name": {
                    "type": "string",
                    "description": "ФИО/наименование менеджера для отображения"
                }
            },
            "required": [
                "uuid",
                "name"
            ]
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "message_id",
        "uuid"
    ]
}

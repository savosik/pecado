{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "order.created.to_erp",
    "title": "order.created (Сайт → 1С)",
    "description": "Новый заказ — отправка в 1С для обработки",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1,
            "description": "Уникальный идентификатор сообщения для идемпотентности (формат: msg-<uuid>)."
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "number": {
            "type": [
                "string",
                "null"
            ]
        },
        "date": {
            "type": "string",
            "format": "date-time"
        },
        "status": {
            "type": "string",
            "description": "Статус заказа в перечислении 1С:КА2.",
            "enum": [
                "pending_approval",
                "pending_payment_before_provision",
                "ready_for_provision",
                "pending_payment_before_shipment",
                "awaiting_provision",
                "ready_for_shipment",
                "shipping",
                "awaiting_payment",
                "ready_for_closure",
                "closed"
            ]
        },
        "type": {
            "type": "string",
            "description": "Тип заказа: 'order' — обычный (склады наличия), 'preorder' — предзаказ (склады предзаказа), 'defect' — уценка/некондиция (склад некондиции), 'promo' — подотчётные промо-позиции по акции (склады наличия региона, выписываются в накладную клиенту), 'promo_sample' — рекламные образцы (склад «Москва подарки», в накладную клиенту НЕ выписываются). Для 'defect' в warehouse_uuids передаётся UUID склада некондиции, а final_price позиций — цена уценки. Для 'promo' и 'promo_sample' final_price — цена из награды акции (может быть 0), и она авторитетна: пересчитывать сумму через discount_percent не нужно."
        },
        "partner_uuid": {
            "type": [
                "string",
                "null"
            ]
        },
        "warehouse_uuids": {
            "type": "array",
            "description": "UUID складов, с которых комплектуется заказ. Для type='defect' — склад некондиции.",
            "items": {
                "type": "string"
            }
        },
        "comment": {
            "type": [
                "string",
                "null"
            ]
        },
        "manager_comment": {
            "type": [
                "string",
                "null"
            ],
            "description": "Комментарий для менеджера — передаётся в отдельный реквизит заказа в 1С"
        },
        "warehouse_comment": {
            "type": [
                "string",
                "null"
            ],
            "description": "Комментарий для склада — передаётся в отдельный реквизит заказа в 1С"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "contractor": {
            "type": [
                "object",
                "null"
            ],
            "properties": {
                "uuid": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "UUID контрагента в 1С (Company.erp_id на сайте), если уже выгружен. 1С матчит по UUID с приоритетом, fallback на tax_id."
                },
                "country": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "legal_name": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "tax_id": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Налоговый идентификатор (ИНН / УНП / БИН и т.д.)"
                },
                "registration_number": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "tax_code": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "okpo_code": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "legal_address": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "actual_address": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "phone": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "email": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "bank_accounts": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "items": {
                        "type": "object",
                        "properties": {
                            "bank_name": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "bank_bik": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "correspondent_account": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "account_number": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "is_primary": {
                                "type": [
                                    "boolean",
                                    "null"
                                ]
                            }
                        }
                    }
                }
            }
        },
        "delivery_address": {
            "type": [
                "string",
                "null"
            ]
        },
        "delivery_method": {
            "type": "string",
            "enum": [
                "delivery",
                "pickup"
            ],
            "default": "delivery",
            "description": "Способ доставки (v15.3): delivery — доставка по адресу, pickup — самовывоз. При pickup delivery_address = null."
        },
        "currency_code": {
            "type": [
                "string",
                "null"
            ]
        },
        "exchange_rate": {
            "type": [
                "number",
                "null"
            ]
        },
        "rate_coefficient": {
            "type": [
                "number",
                "null"
            ]
        },
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "product_uuid": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "quantity": {
                        "type": "number",
                        "minimum": 1
                    },
                    "base_price": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Прайсовая цена товара до корректировки. Всегда цена карточки товара, в том числе в заказах типа 'defect': цена уценки передаётся в final_price, а base_price остаётся базовой ценой товара-родителя (v15.9.3)."
                    },
                    "discount_percent": {
                        "type": "number",
                        "maximum": 100,
                        "description": "Процент корректировки цены относительно base_price: > 0 — скидка, < 0 — наценка. Для заказов типа 'defect' — производная величина (глубина уценки), сумма позиции считается по final_price."
                    },
                    "final_price": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Цена позиции для клиента. Авторитетна: 1С берёт её как есть и не пересчитывает через discount_percent. Для промо-позиций может быть 0."
                    },
                    "is_promo": {
                        "type": "boolean",
                        "description": "Позиция выдана акцией, а не куплена клиентом. Присутствует только в заказах типов 'promo' и 'promo_sample'."
                    },
                    "promo_kind": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "accountable",
                            "sample",
                            null
                        ],
                        "description": "Вид промо-позиции: 'accountable' — подотчётная (выписывается в накладную), 'sample' — рекламный образец (не выписывается). Присутствует только у позиций с is_promo = true."
                    }
                }
            }
        }
    },
    "required": [
        "event",
        "message_id",
        "uuid",
        "items"
    ],
    "additionalProperties": true
}
{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "category.created",
    "title": "category.created / category.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "parent_uuid": {
            "type": [
                "string",
                "null"
            ]
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "is_active": {
            "type": "boolean"
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid"
    ]
}

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "price.updated",
    "title": "price.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "product_uuid": {
            "type": "string",
            "format": "uuid"
        },
        "price": {
            "type": "number",
            "minimum": 0
        }
    },
    "additionalProperties": true,
    "required": [
        "event"
    ]
}

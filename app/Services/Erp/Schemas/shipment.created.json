{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "shipment.created",
    "title": "shipment.created / shipment.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "contractor_inn": {
            "type": "string",
            "minLength": 1
        },
        "date": {
            "type": "string",
            "format": "date"
        },
        "status": {
            "type": "string"
        },
        "currency_code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
        },
        "items": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "product_uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "order_uuid": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "quantity": {
                        "type": "number",
                        "minimum": 0
                    },
                    "price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "auto_discount_percent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "manual_discount_percent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "total": {
                        "type": "number"
                    },
                    "vat_rate": {
                        "type": "number"
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid"
    ]
}

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "shipment.created",
    "title": "shipment.created (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "contractor_uuid": {
            "type": [
                "string",
                "null"
            ],
            "format": "uuid",
            "description": "UUID контрагента в 1С (Company.erp_id на сайте). Приоритет при матчинге, fallback на tax_id+partner_uuid."
        },
        "partner_uuid": {
            "type": [
                "string",
                "null"
            ],
            "format": "uuid",
            "description": "UUID партнёра-владельца. Нужен для корректного фильтра user_id при fallback-поиске Company по tax_id."
        },
        "tax_id": {
            "type": "string",
            "description": "Налоговый идентификатор контрагента (ИНН / УНП / БИН и т.д.)",
            "minLength": 1
        },
        "number": {
            "type": "string",
            "minLength": 1,
            "description": "Номер реализации в 1С. Сохраняется как erp_number на сайте. Обязательное поле."
        },
        "date": {
            "type": "string",
            "format": "date"
        },
        "status": {
            "type": "string"
        },
        "currency_code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
        },
        "items": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "product_uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "order_uuid": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "quantity": {
                        "type": "number",
                        "minimum": 0
                    },
                    "price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "auto_discount_percent": {
                        "type": "number",
                        "maximum": 100
                    },
                    "manual_discount_percent": {
                        "type": "number",
                        "maximum": 100
                    },
                    "total": {
                        "type": "number"
                    },
                    "vat_rate": {
                        "type": "number"
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid",
        "number"
    ]
}

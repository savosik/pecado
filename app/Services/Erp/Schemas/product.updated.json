{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "product.updated",
    "title": "product.updated (1С → Сайт) — частичное обновление",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "name": {
            "type": "string"
        },
        "code": {
            "type": "string"
        },
        "sku": {
            "type": "string"
        },
        "description": {
            "type": [
                "string",
                "null"
            ]
        },
        "description_html": {
            "type": [
                "string",
                "null"
            ],
            "description": "HTML-версия описания товара. Семантика частичного обновления: если поле отсутствует в payload — Product.description_html не трогаем; если передано (включая null/пустую строку) — перезаписываем."
        },
        "category_uuid": {
            "type": "string",
            "format": "uuid"
        },
        "hidden": {
            "type": "boolean",
            "description": "Признак скрытого товара. Строго boolean (true/false). Строки вида 'Да'/'Нет' будут отклонены JSON-парсером."
        },
        "is_marked": {
            "type": "boolean",
            "description": "Признак маркированного товара (обязательная маркировка «Честный знак»). Строго boolean (true/false). Строки вида 'Да'/'Нет' будут отклонены JSON-парсером."
        },
        "brand": {
            "type": [
                "string",
                "object",
                "null"
            ],
            "properties": {
                "uuid": {
                    "type": "string",
                    "format": "uuid"
                },
                "name": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                }
            }
        },
        "barcodes": {
            "type": "array",
            "items": {
                "type": ["string", "number"]
            }
        },
        "model": {
            "type": [
                "object",
                "null"
            ],
            "properties": {
                "uuid": {
                    "type": "string",
                    "format": "uuid"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "attributes": {
            "type": "array",
            "description": "Полный актуальный список атрибутов товара. Семантика full-replace: сайт синхронизирует состав атрибутов товара строго по этому массиву. Атрибуты, отсутствующие в массиве, будут удалены у товара. Пустой массив [] означает «удалить все атрибуты товара». Отсутствие поля attributes в payload означает «не трогать атрибуты» (в отличие от пустого массива). 1С обязана передавать полный набор атрибутов при каждом обновлении, которое затрагивает состав атрибутов.",
            "items": {
                "type": "object",
                "properties": {
                    "property_uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "property_label": {
                        "type": "string"
                    },
                    "value_type": {
                        "type": "string",
                        "enum": ["string", "number", "boolean", "reference", "date-time"],
                        "description": "Тип значения: string, number, boolean или reference (справочник)"
                    },
                    "value_uuid": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "value_label": {
                        "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                        ],
                        "description": "Значение атрибута. Если тип boolean - передавать строго true/false (не 1/0 или 'Да'/'Нет'). Если number - передавать число."
                    }
                }
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid"
    ]
}

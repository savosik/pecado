{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "order.created",
    "title": "order.created (1С → Сайт / Сайт → 1С)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "number": {
            "type": "string"
        },
        "date": {
            "type": "string",
            "format": "date-time"
        },
        "status": {
            "type": "string",
            "description": "Статус заказа в перечислении 1С:КА2. Маппинг русских названий ↔ канонических ключей — в docs-erp/content/rules/orders.md.",
            "enum": [
                "pending_approval",
                "pending_payment_before_provision",
                "ready_for_provision",
                "pending_payment_before_shipment",
                "awaiting_provision",
                "ready_for_shipment",
                "shipping",
                "awaiting_payment",
                "ready_for_closure",
                "closed"
            ]
        },
        "type": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "order",
                "preorder",
                "defect",
                "promo",
                "promo_sample",
                null
            ],
            "description": "Тип заказа. Значения: 'order' — обычный, 'preorder' — предзаказ, 'defect' — уценка, 'promo' — подотчётные промо-позиции, 'promo_sample' — рекламные образцы. ⚠️ v15.9.0: для предзаказа, заведённого менеджером в 1С, поле ОБЯЗАТЕЛЬНО и должно быть равно 'preorder' — по нему сайт ставит позиции в резерв у поставщика (у 1С своего канала к поставщику нет). Иных признаков предзаказа у сайта нет: без 'preorder' документ сохранится как обычный заказ и резерв не уйдёт. Если поле не передано, сайт при создании использует 'order', при обновлении сохраняет текущий тип."
        },
        "partner_uuid": {
            "type": "string",
            "format": "uuid",
            "description": "UUID партнёра (User.erp_id). Required с v13.3."
        },
        "warehouse_uuids": {
            "type": "array",
            "items": {
                "type": "string",
                "format": "uuid"
            },
            "description": "Эхо складов, перечисленных сайтом при оформлении: склады региона, из которых 1С выбирает сама. Фактический склад проведения — в warehouse_uuid (v15.8.0)."
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "erp_created_at": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time",
            "description": "Аудит-метка: дата-время создания документа в 1С (ISO-8601 с TZ). Опционально, добавлено в v13.7."
        },
        "erp_updated_at": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time",
            "description": "Аудит-метка: дата-время последнего изменения документа в 1С (ISO-8601 с TZ). Опционально, добавлено в v13.7."
        },
        "contractor": {
            "type": "object",
            "required": [
                "uuid",
                "tax_id"
            ],
            "properties": {
                "uuid": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID контрагента в 1С (Company.erp_id на сайте). Required с v13.3 — приоритет при матчинге, fallback на tax_id+tax_code."
                },
                "country": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2
                },
                "name": {
                    "type": "string"
                },
                "legal_name": {
                    "type": "string"
                },
                "tax_id": {
                    "type": "string",
                    "description": "Налоговый идентификатор контрагента (ИНН / УНП / БИН и т.д.)"
                },
                "registration_number": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "tax_code": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "okpo_code": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "legal_address": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "actual_address": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "phone": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "email": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "bank_accounts": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "items": {
                        "type": "object",
                        "properties": {
                            "bank_name": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "bank_bik": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "correspondent_account": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "account_number": {
                                "type": "string"
                            },
                            "is_primary": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        "organization": {
            "type": "object",
            "description": "Наша организация (юрлицо), от имени которой документ проведён в 1С. Опционально, добавлено в v15.8.0. Достаточно uuid: справочник организаций ведётся на сайте вручную, 1С его не присылает. Объект без uuid сайт игнорирует. Неизвестный uuid создаёт на сайте организацию-заглушку, которую дозаполняет админ.",
            "properties": {
                "uuid": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID организации в справочнике 1С. Единственное обязательное по смыслу поле: по нему сайт находит организацию в своём справочнике."
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Краткое название организации. Необязательно — используется только если организации с таким uuid на сайте ещё нет."
                },
                "legal_name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Полное юридическое наименование. Необязательно."
                },
                "tax_id": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ИНН организации. Необязательно."
                },
                "tax_code": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "КПП организации. Необязательно."
                }
            },
            "additionalProperties": true
        },
        "warehouse_uuid": {
            "type": [
                "string",
                "null"
            ],
            "format": "uuid",
            "description": "Склад, на который документ фактически проведён в 1С. Опционально, добавлено в v15.8.0. Не путать с warehouse_uuids исходящего заказа: там сайт перечисляет склады региона, из которых 1С выбирает сама. Неизвестный сайту склад не заводится автоматически — поле останется пустым, факт попадёт в лог."
        },
        "delivery_address": {
            "type": "string"
        },
        "delivery_method": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "delivery",
                "pickup",
                null
            ],
            "description": "Способ доставки (v15.3): delivery — доставка по адресу, pickup — самовывоз. Отсутствие поля или null = delivery."
        },
        "currency_code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
        },
        "exchange_rate": {
            "type": "number"
        },
        "rate_coefficient": {
            "type": "number"
        },
        "comment": {
            "type": "string"
        },
        "items": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "product_uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "quantity": {
                        "type": "number",
                        "minimum": 1
                    },
                    "base_price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "discount_percent": {
                        "type": "number",
                        "maximum": 100
                    },
                    "final_price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "is_promo": {
                        "type": "boolean",
                        "description": "Позиция выдана акцией. 1С может проставить его и для позиции, добавленной менеджером вручную — сайт такую позицию принимает и не пытается сопоставить с правилом акции."
                    },
                    "promo_kind": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "accountable",
                            "sample",
                            null
                        ],
                        "description": "Вид промо-позиции: 'accountable' — подотчётная, 'sample' — рекламный образец."
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid",
        "partner_uuid",
        "contractor"
    ]
}

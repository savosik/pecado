{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "partner.deleted",
    "title": "partner.deleted (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "email": {
            "type": "string",
            "format": "email"
        }
    },
    "additionalProperties": true,
    "required": [
        "event"
    ],
    "anyOf": [
        {"required": ["uuid"]},
        {"required": ["email"]}
    ]
}

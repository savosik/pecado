{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "partner.deleted",
    "title": "partner.deleted (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string",
            "description": "Тип события. Всегда «partner.deleted». Ограничено константой в v15.16.0: до этого поле принимало любую строку, и сообщение с чужим event проходило бы валидацию этой схемы.",
            "const": "partner.deleted"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "email": {
            "type": "string",
            "format": "email"
        }
    },
    "additionalProperties": true,
    "required": [
        "event"
    ],
    "anyOf": [
        {
            "required": [
                "uuid"
            ]
        },
        {
            "required": [
                "email"
            ]
        }
    ]
}

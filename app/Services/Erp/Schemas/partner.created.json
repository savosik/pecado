{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "partner.created.from_erp",
    "title": "partner.created (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "login": {
            "type": "string",
            "minLength": 1
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "phone": {
            "type": [
                "string",
                "null"
            ]
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
        },
        "city": {
            "type": [
                "string",
                "null"
            ]
        },
        "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
        },
        "is_active": {
            "type": "boolean"
        },
        "client_status": {
            "type": [
                "string",
                "null"
            ]
        },
        "manager": {
            "type": [
                "object",
                "null"
            ],
            "properties": {
                "uuid": {
                    "type": "string",
                    "description": "UUID пользователя-менеджера в 1С (Справочник «Пользователи»)"
                },
                "name": {
                    "type": "string",
                    "description": "ФИО/наименование менеджера для отображения"
                }
            },
            "required": ["uuid", "name"]
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid",
        "name",
        "email"
    ]
}
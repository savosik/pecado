{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "return.created.to_erp",
    "title": "return.created (Сайт → 1С)",
    "description": "Новый возврат покупателя — отправка в 1С. Позиции возврата привязаны к реализациям (shipment_items), не к заказам.",
    "type": "object",
    "properties": {
        "event": {
            "type": "string",
            "const": "return.created",
            "description": "Тип события. Всегда «return.created». Ограничено константой в v15.16.0: до этого поле принимало любую строку, и сообщение с чужим event проходило бы валидацию этой схемы."
        },
        "message_id": {
            "type": "string",
            "minLength": 1,
            "description": "Уникальный идентификатор сообщения для идемпотентности (формат: msg-<uuid>)."
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "partner_uuid": {
            "type": [
                "string",
                "null"
            ]
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "items": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "product_uuid": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "shipment_uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "shipment_number": {
                        "type": "string",
                        "minLength": 1
                    },
                    "quantity": {
                        "type": "number",
                        "minimum": 1
                    },
                    "price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "currency_code": {
                        "type": "string",
                        "minLength": 3
                    },
                    "subtotal": {
                        "type": "number",
                        "minimum": 0
                    },
                    "reason": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "product_uuid",
                    "shipment_uuid",
                    "shipment_number",
                    "quantity",
                    "price",
                    "currency_code"
                ]
            }
        }
    },
    "required": [
        "event",
        "message_id",
        "uuid",
        "items"
    ],
    "additionalProperties": true
}

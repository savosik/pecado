{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "order.updated",
    "title": "order.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "status": {
            "type": "string"
        },
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "product_uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "quantity": {
                        "type": "number",
                        "minimum": 1
                    },
                    "base_price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "discount_percent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "final_price": {
                        "type": "number",
                        "minimum": 0
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid"
    ]
}

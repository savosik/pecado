{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "order.updated",
    "title": "order.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "number": {
            "type": ["string", "null"],
            "description": "Номер заказа в 1С. Сохраняется как erp_number на сайте для коммуникации с менеджером."
        },
        "status": {
            "type": "string",
            "description": "Статус заказа в перечислении 1С:КА2. Маппинг русских названий ↔ канонических ключей — в docs-erp/content/rules/orders.md.",
            "enum": [
                "pending_approval",
                "pending_payment_before_provision",
                "ready_for_provision",
                "pending_payment_before_shipment",
                "awaiting_provision",
                "ready_for_shipment",
                "shipping",
                "awaiting_payment",
                "ready_for_closure",
                "closed"
            ]
        },
        "delivery_address": {
            "type": ["string", "null"],
            "description": "Адрес доставки (строка). Сайт создаёт или находит запись в delivery_addresses."
        },
        "erp_created_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Аудит-метка: дата-время создания документа в 1С (ISO-8601 с TZ). Опционально, добавлено в v13.7."
        },
        "erp_updated_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Аудит-метка: дата-время последнего изменения документа в 1С (ISO-8601 с TZ). Опционально, добавлено в v13.7."
        },
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "product_uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "quantity": {
                        "type": "number",
                        "minimum": 1
                    },
                    "base_price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "discount_percent": {
                        "type": "number",
                        "maximum": 100
                    },
                    "final_price": {
                        "type": "number",
                        "minimum": 0
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid"
    ]
}

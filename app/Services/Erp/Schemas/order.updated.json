{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "order.updated",
    "title": "order.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "number": {
            "type": [
                "string",
                "null"
            ],
            "description": "Номер заказа в 1С. Сохраняется как erp_number на сайте для коммуникации с менеджером."
        },
        "status": {
            "type": "string",
            "description": "Статус заказа в перечислении 1С:КА2. Маппинг русских названий ↔ канонических ключей — в docs-erp/content/rules/orders.md.",
            "enum": [
                "pending_approval",
                "pending_payment_before_provision",
                "ready_for_provision",
                "pending_payment_before_shipment",
                "awaiting_provision",
                "ready_for_shipment",
                "shipping",
                "awaiting_payment",
                "ready_for_closure",
                "closed"
            ]
        },
        "type": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "order",
                "preorder",
                "defect",
                "promo",
                "promo_sample",
                null
            ],
            "description": "Тип заказа. Если поле не передано, сайт сохраняет свой текущий тип — 1С не обязана его присылать. Значения: 'order' — обычный, 'preorder' — предзаказ, 'defect' — уценка, 'promo' — подотчётные промо-позиции, 'promo_sample' — рекламные образцы."
        },
        "partner_uuid": {
            "type": "string",
            "format": "uuid",
            "description": "UUID партнёра (User.erp_id). Опционально. Добавлено в v15.4: 1С присылает поле фактически с самого начала, но в спецификации оно описано не было. Требуется для самовосстановления заказа (см. rules/orders.md, «Самовосстановление»)."
        },
        "contractor": {
            "type": "object",
            "description": "Контрагент заказа. Опционально. Добавлено в v15.4 — см. partner_uuid. Используется только при самовосстановлении заказа; для существующего заказа контрагент не переназначается.",
            "properties": {
                "uuid": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID контрагента в 1С (Company.erp_id на сайте)."
                },
                "tax_id": {
                    "type": "string",
                    "description": "Налоговый идентификатор контрагента (ИНН / УНП / БИН и т.д.)."
                },
                "tax_code": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "legal_name": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "additionalProperties": true
        },
        "delivery_address": {
            "type": [
                "string",
                "null"
            ],
            "description": "Адрес доставки (строка). Сайт создаёт или находит запись в delivery_addresses."
        },
        "delivery_method": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "delivery",
                "pickup",
                null
            ],
            "description": "Способ доставки (v15.3): delivery — доставка по адресу, pickup — самовывоз. Отсутствие ключа или null — способ доставки не меняется."
        },
        "erp_created_at": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time",
            "description": "Аудит-метка: дата-время создания документа в 1С (ISO-8601 с TZ). Опционально, добавлено в v13.7."
        },
        "erp_updated_at": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time",
            "description": "Аудит-метка: дата-время последнего изменения документа в 1С (ISO-8601 с TZ). Опционально, добавлено в v13.7."
        },
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "product_uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "quantity": {
                        "type": "number",
                        "minimum": 1
                    },
                    "base_price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "discount_percent": {
                        "type": "number",
                        "maximum": 100
                    },
                    "final_price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "is_promo": {
                        "type": "boolean",
                        "description": "Позиция выдана акцией. 1С может проставить его и для позиции, добавленной менеджером вручную — сайт такую позицию принимает и не пытается сопоставить с правилом акции."
                    },
                    "promo_kind": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "accountable",
                            "sample",
                            null
                        ],
                        "description": "Вид промо-позиции: 'accountable' — подотчётная, 'sample' — рекламный образец."
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid"
    ]
}

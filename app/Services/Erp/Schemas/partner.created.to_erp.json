{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "partner.created.to_erp",
    "title": "partner.created (Сайт → 1С)",
    "description": "Создание пользователя — отправка данных партнёра в 1С",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "uuid": {
            "type": "string",
            "minLength": 1
        },
        "login": {
            "type": "string",
            "minLength": 1
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "phone": {
            "type": [
                "string",
                "null"
            ]
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "is_active": {
            "type": "boolean"
        },
        "comment": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "event",
        "uuid",
        "login",
        "name",
        "email"
    ],
    "additionalProperties": true
}

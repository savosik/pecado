{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "return.updated",
    "title": "return.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "number": {
            "type": [
                "string",
                "null"
            ],
            "description": "Номер возврата в 1С. Сохраняется как erp_number на сайте."
        },
        "organization": {
            "type": "object",
            "description": "Наша организация (юрлицо) возврата. Опционально, добавлено в v15.8.0. Справочно: сайт выводит её из реализаций-оснований сам, значение 1С считается приоритетным. Достаточно uuid.",
            "properties": {
                "uuid": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID организации в справочнике 1С. Единственное обязательное по смыслу поле: по нему сайт находит организацию в своём справочнике."
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Краткое название организации. Необязательно — используется только если организации с таким uuid на сайте ещё нет."
                },
                "legal_name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Полное юридическое наименование. Необязательно."
                },
                "tax_id": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ИНН организации. Необязательно."
                },
                "tax_code": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "КПП организации. Необязательно."
                }
            },
            "additionalProperties": true
        },
        "status": {
            "type": "string",
            "enum": [
                "pending_approval",
                "for_return",
                "in_reserve",
                "ready_for_shipment",
                "completed",
                "rejected"
            ],
            "description": "Статус возврата в перечислении 1С:КА2 (v15). Маппинг: НеСогласована=pending_approval, КВозврату=for_return, КОбеспечению=in_reserve, КОтгрузке=ready_for_shipment, Выполнена=completed, Отклонена=rejected. Полная таблица — в docs-erp/content/rules/returns.md."
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid"
    ]
}

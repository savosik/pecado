{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "return.updated",
    "title": "return.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "number": {
            "type": ["string", "null"],
            "description": "Номер возврата в 1С. Сохраняется как erp_number на сайте."
        },
        "status": {
            "type": "string"
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid"
    ]
}

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "shipment.updated",
    "title": "shipment.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "uuid": {
            "type": "string",
            "format": "uuid"
        },
        "contractor_uuid": {
            "type": "string",
            "format": "uuid",
            "description": "UUID контрагента в 1С (Company.erp_id на сайте). Required с v13.3 — приоритет при матчинге, fallback на tax_id."
        },
        "partner_uuid": {
            "type": [
                "string",
                "null"
            ],
            "format": "uuid",
            "description": "UUID партнёра-владельца. Опциональное поле — отгрузка может быть технической (внутренние перемещения)."
        },
        "tax_id": {
            "type": "string",
            "description": "Налоговый идентификатор контрагента (ИНН / УНП / БИН и т.д.)",
            "minLength": 1
        },
        "organization": {
            "type": "object",
            "description": "Наша организация (юрлицо), от имени которой документ проведён в 1С. Опционально, добавлено в v15.8.0. Достаточно uuid: справочник организаций ведётся на сайте вручную, 1С его не присылает. Объект без uuid сайт игнорирует. Неизвестный uuid создаёт на сайте организацию-заглушку, которую дозаполняет админ.",
            "properties": {
                "uuid": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID организации в справочнике 1С. Единственное обязательное по смыслу поле: по нему сайт находит организацию в своём справочнике."
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Краткое название организации. Необязательно — используется только если организации с таким uuid на сайте ещё нет."
                },
                "legal_name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Полное юридическое наименование. Необязательно."
                },
                "tax_id": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ИНН организации. Необязательно."
                },
                "tax_code": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "КПП организации. Необязательно."
                }
            },
            "additionalProperties": true
        },
        "warehouse_uuid": {
            "type": [
                "string",
                "null"
            ],
            "format": "uuid",
            "description": "Склад, на который документ фактически проведён в 1С. Опционально, добавлено в v15.8.0. Не путать с warehouse_uuids исходящего заказа: там сайт перечисляет склады региона, из которых 1С выбирает сама. Неизвестный сайту склад не заводится автоматически — поле останется пустым, факт попадёт в лог."
        },
        "number": {
            "type": "string",
            "minLength": 1,
            "description": "Номер реализации в 1С. Сохраняется как erp_number на сайте. Обязательное поле."
        },
        "date": {
            "type": "string",
            "format": "date"
        },
        "erp_created_at": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time",
            "description": "Аудит-метка: дата-время создания документа в 1С (ISO-8601 с TZ). Опционально, добавлено в v13.7."
        },
        "erp_updated_at": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time",
            "description": "Аудит-метка: дата-время последнего изменения документа в 1С (ISO-8601 с TZ). Опционально, добавлено в v13.7."
        },
        "status": {
            "type": "string"
        },
        "currency_code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
        },
        "items": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "product_uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "order_uuid": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "quantity": {
                        "type": "number",
                        "minimum": 0
                    },
                    "price": {
                        "type": "number",
                        "minimum": 0
                    },
                    "auto_discount_percent": {
                        "type": "number",
                        "maximum": 100
                    },
                    "manual_discount_percent": {
                        "type": "number",
                        "maximum": 100
                    },
                    "total": {
                        "type": "number"
                    },
                    "vat_rate": {
                        "type": "number"
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event",
        "uuid",
        "number",
        "contractor_uuid"
    ]
}

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "balance.updated",
    "title": "balance.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "partner_uuid": {
            "type": "string",
            "format": "uuid"
        },
        "updated_at": {
            "type": "string",
            "format": "date-time"
        },
        "contractors": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "uuid": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uuid",
                        "description": "UUID контрагента в 1С (Company.erp_id на сайте). Приоритет при матчинге Company и заполнении ContractorBalance.contractor_uuid."
                    },
                    "tax_id": {
                        "type": "string",
                        "description": "Налоговый идентификатор контрагента (ИНН / УНП / БИН и т.д.)"
                    },
                    "current_balance": {
                        "type": "number",
                        "description": "Текущий баланс пользователя. Значение может быть отрицательным"
                    },
                    "overdue_debt": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Сумма просроченной задолженности. Значение всегда > 0"
                    },
                    "overdue_details": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "shipment_uuid": {
                                    "type": "string",
                                    "format": "uuid"
                                },
                                "amount": {
                                    "type": "number"
                                },
                                "due_date": {
                                    "type": "string",
                                    "format": "date"
                                }
                            }
                        }
                    },
                    "organizations": {
                        "type": "array",
                        "description": "Разрез задолженности по нашим организациям. Опционально, добавлено в v15.8.0. Сумма current_balance по массиву должна совпадать с current_balance контрагента; при расхождении сайт берёт значение контрагента и пишет предупреждение в лог. Организация, исчезнувшая из массива, на сайте обнуляется, а не удаляется.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "uuid": {
                                    "type": "string",
                                    "format": "uuid",
                                    "description": "UUID нашей организации, перед которой у контрагента долг."
                                },
                                "name": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "description": "Название организации. Необязательно."
                                },
                                "current_balance": {
                                    "type": "number",
                                    "description": "Баланс контрагента перед этой организацией. Может быть отрицательным."
                                },
                                "overdue_debt": {
                                    "type": "number",
                                    "minimum": 0,
                                    "description": "Просроченная задолженность перед этой организацией."
                                },
                                "overdue_details": {
                                    "type": "array",
                                    "description": "Расшифровка просрочки по реализациям этой организации.",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "shipment_uuid": {
                                                "type": "string",
                                                "format": "uuid"
                                            },
                                            "amount": {
                                                "type": "number"
                                            },
                                            "due_date": {
                                                "type": "string",
                                                "format": "date"
                                            }
                                        },
                                        "additionalProperties": true
                                    }
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                },
                "required": [
                    "tax_id",
                    "current_balance"
                ],
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event"
    ]
}
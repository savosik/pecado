{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "balance.updated",
    "title": "balance.updated (1С → Сайт)",
    "type": "object",
    "properties": {
        "event": {
            "type": "string"
        },
        "message_id": {
            "type": "string",
            "minLength": 1
        },
        "partner_uuid": {
            "type": "string",
            "format": "uuid"
        },
        "updated_at": {
            "type": "string"
        },
        "contractors": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "tax_id": {
                        "type": "string",
                        "description": "Налоговый идентификатор контрагента (ИНН / УНП / БИН и т.д.)"
                    },
                    "current_balance": {
                        "type": "number",
                        "description": "Текущий баланс пользователя. Значение может быть отрицательным"
                    },
                    "overdue_debt": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Сумма просроченной задолженности. Значение всегда > 0"
                    },
                    "overdue_details": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "shipment_uuid": {
                                    "type": "string",
                                    "format": "uuid"
                                },
                                "amount": {
                                    "type": "number"
                                },
                                "due_date": {
                                    "type": "string",
                                    "format": "date"
                                }
                            }
                        }
                    }
                },
                "required": [
                    "tax_id",
                    "current_balance"
                ],
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true,
    "required": [
        "event"
    ]
}
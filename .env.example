APP_NAME=Pecado
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://loc.pecado.ru:8085

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=loc.pecado.ru
SANCTUM_STATEFUL_DOMAINS=loc.pecado.ru

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Список admin-получателей через запятую (Spatie Health, ошибки очередей и т.п.)
MAIL_ADMIN_RECIPIENTS=

# Feature-флаги транзакционных писем. На prod включаются поканально после деплоя кода.
MAIL_FEATURE_WELCOME=false
MAIL_FEATURE_PASSWORD_CHANGED=false
MAIL_FEATURE_ORDER_CREATED=false
MAIL_FEATURE_ORDER_STATUS=false
MAIL_FEATURE_MANAGER_ORDER=false
MAIL_FEATURE_RETURN_CREATED=false
MAIL_FEATURE_RETURN_STATUS=false
MAIL_FEATURE_ENTITY_SUBSCRIPTIONS=false

# Показывать ли клиенту его долги в кабинете: раздел «Оплаты», блок оплаты
# и график в карточке реализации, предоплата в заказе, баланс на дашборде.
# Выключено, пока цифры долга не сверены с 1С (см. config/cabinet.php).
CABINET_FINANCE_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Публичный URL для медиа из MinIO. Nginx проксирует /storage/ → http://minio:9000/<bucket>/
# (см. docker/nginx/{prod.conf,default.conf}). Конвенция везде одинаковая: путь /storage,
# меняется только домен. На prod: https://pecado.ru/storage, на dev: https://dev.pecado.ru/storage.
AWS_URL=

# MinIO bucket для CSV с индивидуальными ценами (1С → сайт).
# Без этих ключей ProcessIndividualPricesFile падает на $disk->exists() с 403.
PRICES_S3_ACCESS_KEY=
PRICES_S3_SECRET_KEY=
PRICES_S3_BUCKET=prices-exchange
PRICES_S3_ENDPOINT=http://minio:9000
PRICES_S3_REGION=us-east-1

VITE_APP_NAME="${APP_NAME}"

# Vite HMR — host и порт, на которые браузер подключается извне Docker.
# Для loc.pecado.ru используем тот же домен (проброшенный порт 5174).
VITE_HMR_HOST=loc.pecado.ru
VITE_HMR_CLIENT_PORT=5174

# ─── Локальный dev: данные с dev-сервера ──────────────────────────────
# Spatie Media Library читает товарные изображения с диска (по умолчанию
# 'public'). Чтобы локально читать из dev MinIO — переключить на
# 's3_dev_readonly' (это делает scripts/setup-local-dev.sh).
# В CI/prod значение остаётся дефолтным, чтобы Spatie не пыталась ходить
# в недоступный dev MinIO.
MEDIA_DISK=public

# Очередь, в которую Spatie диспатчит PerformConversionsJob (генерация
# thumb/large и т.п.). Имя должно совпадать с supervisor-программой
# media-conversions-worker (см. docker/supervisor/conf.d/worker.conf),
# иначе тяжёлая регенерация уйдёт в default и забьёт основные воркеры.
MEDIA_QUEUE=media-conversions

# Dev MinIO (bucket pecado, public). Креды из docs/DEV_SERVER_CREDENTIALS.md.
# ⚠️ Порт 9000 на dev закрыт наружу — прямой доступ работает только через
# SSH-туннель: ssh -L 9000:localhost:9000 ladmin@dev.pecado.ru
DEV_S3_KEY=sail
DEV_S3_SECRET=password
DEV_S3_REGION=us-east-1
DEV_S3_BUCKET=pecado
DEV_S3_ENDPOINT=http://93.94.150.74:9000

# Доступ для scripts/db-pull.sh (SSH + mysqldump на dev-сервер).
DEV_DB_SSH_HOST=ladmin@dev.pecado.ru
DEV_DB_NAME_MAIN=pecado
DEV_DB_NAME_PRICES=pecado_prices
DEV_DB_REMOTE_USER=pecado
DEV_DB_REMOTE_PASS=secret
# На dev-сервере MySQL запущен в Docker — mysqldump вызывается через docker exec.
DEV_DB_REMOTE_CONTAINER_MAIN=pecado-mysql
DEV_DB_REMOTE_CONTAINER_PRICES=pecado-mysql-prices

CONTEXT7_API_KEY=

# sex-opt: Bearer-токен backend API (catalog:fetch-missing-media)
SEX_OPT_API_TOKEN=
# sex-opt: полный URL JSON-экспорта медиа (catalog:import-media), включая ?auth_token=...
SEX_OPT_EXPORT_URL=

# Отправка предзаказов поставщику (Customer API sex-opt.ru, метод send_order).
# См. docs/SUPPLIER_PREORDERS.md
SUPPLIER_ORDER_API_URL=https://api.sex-opt.ru/customer/api/v1
SUPPLIER_ORDER_API_KEY=
SUPPLIER_ORDER_API_TIMEOUT=30
# Мастер-выключатель отправки
SUPPLIER_PREORDER_ENABLED=false
# Склад поставщика: tmn | msk
SUPPLIER_PREORDER_STOCK=tmn
# Тестовый режим (поставщик откатывает транзакцию). По умолчанию: везде кроме production
SUPPLIER_PREORDER_TESTMODE=true
# Откатывать заказ целиком, если поставщик смог набрать не всё
SUPPLIER_PREORDER_ROLLBACK_ON_WARNINGS=false

# DaData (бесплатный «Лёгкий» тариф, лимит 10 000 запросов/день)
DADATA_API_KEY=
DADATA_SECRET_KEY=
DADATA_SUGGESTIONS_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs
DADATA_CACHE_TTL=86400
DADATA_REQUEST_TIMEOUT=10

# Yandex Maps JavaScript API v2.1 (бесплатный тариф, лимит 25 000 загрузок/сутки).
# Используется только как UI: карта + метка. Поиск/геокодирование адресов идёт
# через DaData. Ключ публичный — попадает в HTML, ограничивайте по HTTP Referer
# в кабинете Yandex.
YANDEX_MAPS_API_KEY=

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey123
SCOUT_DRIVER=meilisearch

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Прокси для запросов к OpenRouter. Нужен только на проде: OpenRouter отдаёт 403
# на запросы с IP сервера, поэтому они уходят через контейнер outbound-proxy (SSH-туннель до VPS).
# Пусто — ходим напрямую.
OPENROUTER_PROXY=

# Meilisearch Vector Search (embeddings via OpenRouter)
MEILISEARCH_EMBEDDER_URL=https://openrouter.ai/api/v1/embeddings
MEILISEARCH_EMBEDDER_MODEL=openai/text-embedding-3-large
MEILISEARCH_EMBEDDER_DIMENSIONS=3072
SEARCH_HYBRID_ENABLED=false
SEARCH_SEMANTIC_RATIO=0.3

# Поиск в личном кабинете — fuzzy за фича-флагами (см. config/search-cabinet.php)
CABINET_SEARCH_FUZZY_DOCUMENTS=false
CABINET_SEARCH_FUZZY_PRODUCTS=false
CABINET_SEARCH_PRESETS=false
CABINET_SEARCH_EXPORT=false
CABINET_SEARCH_SUGGESTIONS=false

# Individual Prices Database (отдельный контейнер)
DB_PRICES_HOST=mysql-prices
DB_PRICES_PORT=3306
DB_PRICES_DATABASE=pecado_prices
DB_PRICES_USERNAME=pecado
DB_PRICES_PASSWORD=secret

# Read-only доступ BI / ИИ-агента отчётов (пользователь bi_agent).
# Права выдаёт `php artisan bi:sync-grants`; ходит через вьюхи схемы analytics
# без секретных колонок. Пароль задать на проде, локально — совпадает с DB_PASSWORD.
DB_ANALYTICS_USERNAME=bi_agent
DB_ANALYTICS_PASSWORD=

# ERP Integration
ERP_BUS_LOGGING_ENABLED=false

# RabbitMQ пользователь для 1С (AMQP из локальной сети).
# Используется деплоем для идемпотентного провижининга (rabbitmqctl).
# Оставьте пустыми, если пользователь не нужен.
RABBITMQ_ERP_USER=
RABBITMQ_ERP_PASSWORD=

# Moscow ESB Shovel (внешние остатки → external.remains)
# Оставьте MOSCOW_ESB_AMQP_URI пустым, чтобы не создавать shovel в локальном dev.
MOSCOW_ESB_AMQP_URI=
MOSCOW_ESB_SRC_QUEUE=remains_for_moscow
MOSCOW_ESB_SHOVEL_PREFETCH=1000
MOSCOW_ESB_SHOVEL_RECONNECT_DELAY=5

# Andrey ESB Shovel (заказы из чужой 1С → external.orders_from_andrey)
# URI вида amqp://pecado:<password>@esb.services.andrey.company:45671/%2F (plain AMQP, vhost `/`).
# ВАЖНО: `%2F` = URL-кодированный `/` (default vhost). Хвост просто `/` = пустой vhost
# и приводит к `access to target virtual host was refused`.
# Реальные креды на prod — в docs/ANDREY_ESB_CONNECTION.md (.gitignore).
# Оставьте ANDREY_ESB_AMQP_URI пустым, чтобы не создавать shovel в локальном dev.
ANDREY_ESB_AMQP_URI=
ANDREY_ESB_SRC_QUEUE=pecado.orders
ANDREY_ESB_SHOVEL_PREFETCH=100
ANDREY_ESB_SHOVEL_RECONNECT_DELAY=5

# TTL сообщений в очередях external.remains_for_* (мс). По умолчанию 3 дня.
EXTERNAL_REMAINS_TTL_MS=259200000

# UUID склада «Тюмень Основной» в системе 1С — единственный склад,
# по которому сайт берёт остатки из события product.quantity.updated
# (external.remains_for_website). Остальные склады в сообщении игнорируются.
EXTERNAL_REMAINS_TYUMEN_WAREHOUSE_UUID=f8083799-0838-11e0-a1ea-505054503030

# ⚠️ ВРЕМЕННЫЙ КОСТЫЛЬ: в исходящих preorder-сообщениях UUID склада
# «Тюмень Основной» (SOURCE) подменяется на TARGET. Только для предзаказов.
# Откат: PREORDER_WAREHOUSE_UUID_OVERRIDE_ENABLED=false.
PREORDER_WAREHOUSE_UUID_OVERRIDE_ENABLED=true
PREORDER_WAREHOUSE_UUID_OVERRIDE_SOURCE=f8083799-0838-11e0-a1ea-505054503030
PREORDER_WAREHOUSE_UUID_OVERRIDE_TARGET=3d0a3eb9-0c23-11ee-8ddc-ee348b24c7ce

# Laravel Pulse
PULSE_ENABLED=true
PULSE_PATH=pulse

# Выдача промо-позиций конструктором акций. Пока выключено, правило нельзя
# перевести в режим «Выдавать» — акции работают только в режиме показа.
PROMO_ISSUE_ENABLED=false

# Организации (юрлица-продавцы). Гейтит показ графы «Продавец» в документах:
# админка, ЛК, CRM, отчёты. Приём организаций из 1С работает независимо от флага.
ORGANIZATIONS_ENABLED=true

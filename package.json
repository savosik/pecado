{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "lint:js": "eslint resources/js && npm run lint:ts",
        "lint:ts": "tsc --noEmit -p tsconfig.lint.json",
        "dev": "vite",
        "asyncapi:validate": "npx -y @asyncapi/cli@4.1.1 validate docs/asyncapi/pecado-erp-integration.yaml",
        "asyncapi:bundle": "npx -y @asyncapi/cli@4.1.1 bundle docs/asyncapi/pecado-erp-integration.yaml -o docs/asyncapi/pecado-erp-bundled.yaml",
        "asyncapi:html": "timeout 420 npx -y @asyncapi/cli@4.1.1 generate fromTemplate docs/asyncapi/pecado-erp-integration.yaml @asyncapi/html-template@2.3.10 -o docs/asyncapi/html --force-write",
        "asyncapi:html:safe": "npm run asyncapi:html || { echo '::warning::asyncapi:html failed (upstream generator regression) — using committed HTML'; git checkout -- docs/asyncapi/html 2>/dev/null || true; }",
        "asyncapi:build": "npm run asyncapi:validate && npm run asyncapi:bundle && npm run asyncapi:html:safe"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.0.0",
        "@typescript-eslint/parser": "^8.66.0",
        "@vitejs/plugin-react": "^4.5.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^15.15.0",
        "js-yaml": "^4.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "vite": "^7.0.7",
        "vite-jsconfig-paths": "^2.0.1"
    },
    "dependencies": {
        "@chakra-ui/react": "^3.31.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@editorjs/delimiter": "^1.4.2",
        "@editorjs/editorjs": "^2.30.8",
        "@editorjs/embed": "^2.7.6",
        "@editorjs/header": "^2.8.8",
        "@editorjs/image": "^2.10.1",
        "@editorjs/inline-code": "^1.5.1",
        "@editorjs/list": "^2.0.2",
        "@editorjs/marker": "^1.4.0",
        "@editorjs/nested-list": "^1.4.3",
        "@editorjs/quote": "^2.7.2",
        "@editorjs/table": "^2.4.3",
        "@editorjs/warning": "^1.4.0",
        "@emotion/react": "^11.14.0",
        "@inertiajs/react": "^2.0.0",
        "@milkdown/ctx": "^7.18.0",
        "@tiptap/extension-bubble-menu": "^3.22.1",
        "@tiptap/extension-color": "^3.22.1",
        "@tiptap/extension-floating-menu": "^3.22.1",
        "@tiptap/extension-highlight": "^3.22.1",
        "@tiptap/extension-image": "^3.22.1",
        "@tiptap/extension-link": "^3.22.1",
        "@tiptap/extension-placeholder": "^3.22.1",
        "@tiptap/extension-subscript": "^3.22.1",
        "@tiptap/extension-superscript": "^3.22.1",
        "@tiptap/extension-table": "^3.22.1",
        "@tiptap/extension-table-cell": "^3.22.1",
        "@tiptap/extension-table-header": "^3.22.1",
        "@tiptap/extension-table-row": "^3.22.1",
        "@tiptap/extension-task-item": "^3.22.1",
        "@tiptap/extension-task-list": "^3.22.1",
        "@tiptap/extension-text-align": "^3.22.1",
        "@tiptap/extension-text-style": "^3.22.1",
        "@tiptap/extension-underline": "^3.22.1",
        "@tiptap/pm": "^3.22.1",
        "@tiptap/react": "^3.22.1",
        "@tiptap/starter-kit": "^3.22.1",
        "@uiw/react-md-editor": "^4.1.0",
        "@zxing/browser": "^0.2.0",
        "dompurify": "^3.3.1",
        "html2canvas": "^1.4.1",
        "next-themes": "^0.4.6",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-icons": "^5.7.0",

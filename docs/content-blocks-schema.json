{
  "_meta": {
    "description": "Полная схема всех блоков контента Pecado Editor.js. Включает встроенные блоки и все кастомные инструменты. Используется как спецификация для Editor.js в админке и как референс для AI-генерации контента через API.",
    "version": "2.0",
    "updated": "2026-04-13",
    "usage": "AI должен возвращать объект { blocks: [...] } с блоками из этой схемы. Порядок блоков = порядок на странице.",
    "totalBlockTypes": 38,
    "categories": {
      "text": ["header", "paragraph", "list", "quote", "pullQuote"],
      "media": ["image", "gallery", "imageCarousel", "photoMosaic", "coverImage", "beforeAfter", "logoWall"],
      "layout": ["columns", "imageText", "twoColumns", "threeColumns", "iconFeature", "tabs"],
      "data": ["table", "comparison", "pricingTable", "stats", "steps", "timeline", "faq"],
      "interactive": ["callToAction", "button", "alertBanner", "countdown", "productCarousel", "embed", "map"],
      "people": ["opinionBox", "reviews", "team"],
      "utility": ["delimiter", "spacer", "warning"]
    }
  },

  "blockTypes": {

    "header": {
      "description": "Заголовок. Уровни: 2 (секция), 3 (подсекция), 4 (мелкий).",
      "toolbox": "Заголовок",
      "schema": {
        "type": "header",
        "data": {
          "text": "string",
          "level": "2 | 3 | 4"
        }
      },
      "example": {
        "type": "header",
        "data": { "text": "Тренды рынка интим-товаров 2026", "level": 2 }
      }
    },

    "paragraph": {
      "description": "Абзац текста. Поддерживает inline HTML: <b>, <i>, <a href>, <mark>, <code>.",

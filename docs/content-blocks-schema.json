{
  "_meta": {
    "description": "Схема блоков контента Pecado. Используется как спецификация для Editor.js в админке и как референс для AI-генерации контента через API.",
    "version": "1.0",
    "usage": "AI должен возвращать объект { blocks: [...] } с блоками из этой схемы. Порядок блоков = порядок на странице."
  },

  "blockTypes": {

    "header": {
      "description": "Заголовок. Уровни: 2 (секция), 3 (подсекция), 4 (мелкий).",
      "schema": {
        "type": "header",
        "data": {
          "text": "string",
          "level": "2 | 3 | 4"
        }
      },
      "example": {
        "type": "header",
        "data": { "text": "Тренды рынка интим-товаров 2026", "level": 2 }
      }
    },

    "paragraph": {
      "description": "Абзац текста. Поддерживает inline HTML: <b>, <i>, <a href>, <mark>.",
      "schema": {
        "type": "paragraph",
        "data": {
          "text": "string (может содержать inline HTML)"
        }
      },
      "example": {
        "type": "paragraph",
        "data": { "text": "Рынок товаров для взрослых в России демонстрирует <b>стабильный рост</b> — по данным аналитиков, объём B2B-сектора увеличился на 23% за последний год." }
      }
    },

    "image": {
      "description": "Изображение с подписью. URL должен быть абсолютным путём к загруженному файлу.",
      "schema": {
        "type": "image",
        "data": {
          "url": "string (URL изображения)",
          "caption": "string (подпись, опционально)",
          "alt": "string (alt-текст для SEO)",
          "withBorder": "boolean (рамка, опционально)",
          "stretched": "boolean (на всю ширину, опционально)"
        }
      },
      "example": {
        "type": "image",
        "data": {
          "url": "/storage/media/articles/trends-2026-hero.jpg",
          "caption": "Выставка интим-товаров EroExpo 2026",
          "alt": "Стенды производителей на выставке EroExpo 2026",
          "stretched": true
        }
      }
    },

    "list": {
      "description": "Маркированный или нумерованный список.",
      "schema": {
        "type": "list",
        "data": {
          "style": "'unordered' | 'ordered'",
          "items": ["string", "string"]
        }
      },
      "example": {
        "type": "list",
        "data": {
          "style": "unordered",
          "items": [
            "Увеличение среднего чека на 15%",
            "Рост доли онлайн-продаж до 60%",
            "Спрос на премиум-сегмент +30%"
          ]
        }
      }
    },

    "quote": {
      "description": "Цитата с указанием автора.",
      "schema": {
        "type": "quote",
        "data": {
          "text": "string (текст цитаты)",
          "caption": "string (автор / источник)",
          "alignment": "'left' | 'center'"
        }
      },
      "example": {
        "type": "quote",
        "data": {
          "text": "Качественная продукция и надёжный сервис — основа долгосрочных партнёрских отношений.",
          "caption": "Команда Pecado",
          "alignment": "left"
        }
      }
    },

    "delimiter": {
      "description": "Визуальный разделитель между секциями. Не содержит данных.",
      "schema": {
        "type": "delimiter",
        "data": {}
      },
      "example": {
        "type": "delimiter",
        "data": {}
      }
    },

    "table": {
      "description": "Таблица с данными. Первая строка может быть заголовком.",
      "schema": {
        "type": "table",
        "data": {
          "withHeadings": "boolean",
          "content": [["string", "string"], ["string", "string"]]
        }
      },
      "example": {
        "type": "table",
        "data": {
          "withHeadings": true,
          "content": [
            ["Категория", "Рост продаж", "Доля рынка"],
            ["Вибраторы", "+25%", "32%"],
            ["Лубриканты", "+18%", "21%"],
            ["Бельё", "+35%", "15%"]
          ]
        }
      }
    },

    "warning": {
      "description": "Информационный блок с акцентом (совет, предупреждение, важно).",
      "schema": {
        "type": "warning",
        "data": {
          "title": "string (заголовок блока)",
          "message": "string (текст)"
        }
      },
      "example": {
        "type": "warning",
        "data": {
          "title": "Обратите внимание",
          "message": "Минимальная сумма первого заказа — 15 000 ₽. Для постоянных клиентов ограничений нет."
        }
      }
    },

    "imageText": {
      "description": "Блок «изображение + текст рядом». Двухколоночная компоновка.",
      "schema": {
        "type": "imageText",
        "data": {
          "image": "string (URL изображения)",
          "imageAlt": "string",
          "imagePosition": "'left' | 'right'",
          "title": "string (заголовок текстовой части)",
          "text": "string (текст, может содержать inline HTML)"
        }
      },
      "example": {
        "type": "imageText",
        "data": {
          "image": "/storage/media/brands/satisfyer-factory.jpg",
          "imageAlt": "Производство Satisfyer в Германии",
          "imagePosition": "left",
          "title": "Немецкое качество",
          "text": "Все изделия Satisfyer проходят <b>трёхступенчатый контроль качества</b> на заводе в Билефельде. Компания использует только медицинский силикон и гипоаллергенные материалы."
        }
      }
    },

    "twoColumns": {
      "description": "Две колонки с иконкой/заголовком/текстом. Для преимуществ, сравнений.",
      "schema": {
        "type": "twoColumns",
        "data": {
          "columns": [
            {
              "icon": "string (emoji или имя иконки)",
              "title": "string",
              "text": "string"
            }
          ]
        }
      },
      "example": {
        "type": "twoColumns",
        "data": {
          "columns": [
            {
              "icon": "🚚",
              "title": "Быстрая доставка",
              "text": "Отправляем заказы в день оплаты. Доставка по всей России от 2 дней."
            },
            {
              "icon": "📦",
              "title": "Дискретная упаковка",
              "text": "Нейтральная упаковка без логотипов и указания содержимого."
            }
          ]
        }
      }
    },

    "threeColumns": {
      "description": "Три колонки. Для преимуществ, характеристик, этапов.",
      "schema": {
        "type": "threeColumns",
        "data": {
          "columns": [
            {
              "icon": "string",
              "title": "string",
              "text": "string"
            }
          ]
        }
      },
      "example": {
        "type": "threeColumns",
        "data": {
          "columns": [
            { "icon": "🔒", "title": "Безопасность", "text": "Сертифицированные материалы" },
            { "icon": "💎", "title": "Премиум", "text": "Только проверенные бренды" },
            { "icon": "🤝", "title": "Партнёрство", "text": "Индивидуальные условия" }
          ]
        }
      }
    },

    "productCarousel": {
      "description": "Карусель товаров. Указываются ID товаров или slug подборки. Товары подгружаются из базы при рендере.",
      "schema": {
        "type": "productCarousel",
        "data": {
          "title": "string (заголовок секции, опционально)",
          "productIds": ["number (ID товаров)"],
          "selectionSlug": "string (slug подборки — альтернатива productIds)",
          "maxItems": "number (макс. кол-во, по умолчанию 10)"
        }
      },
      "examples": [
        {
          "_comment": "По конкретным ID товаров",
          "type": "productCarousel",
          "data": {
            "title": "Бестселлеры Satisfyer",
            "productIds": [142, 567, 891, 234, 456]
          }
        },
        {
          "_comment": "По подборке",
          "type": "productCarousel",
          "data": {
            "title": "Новинки сезона",
            "selectionSlug": "novinki",
            "maxItems": 8
          }
        }
      ]
    },

    "callToAction": {
      "description": "CTA-баннер с кнопкой. Привлечение внимания к действию.",
      "schema": {
        "type": "callToAction",
        "data": {
          "title": "string (заголовок)",
          "text": "string (описание, опционально)",
          "buttonText": "string (текст кнопки)",
          "buttonUrl": "string (URL кнопки)",
          "style": "'primary' | 'secondary' | 'gradient'"
        }
      },
      "example": {
        "type": "callToAction",
        "data": {
          "title": "Готовы начать сотрудничество?",
          "text": "Оформите первый заказ и получите персонального менеджера",
          "buttonText": "Перейти в каталог",
          "buttonUrl": "/catalog",
          "style": "gradient"
        }
      }
    },

    "gallery": {
      "description": "Галерея изображений в сетке.",
      "schema": {
        "type": "gallery",
        "data": {
          "images": [
            {
              "url": "string",
              "alt": "string",
              "caption": "string (опционально)"
            }
          ],
          "columns": "2 | 3 | 4"
        }
      },
      "example": {
        "type": "gallery",
        "data": {
          "columns": 3,
          "images": [
            { "url": "/storage/media/gallery/img1.jpg", "alt": "Выставочный стенд", "caption": "EroExpo 2026" },
            { "url": "/storage/media/gallery/img2.jpg", "alt": "Новая коллекция", "caption": "Весна 2026" },
            { "url": "/storage/media/gallery/img3.jpg", "alt": "Упаковка продукции", "caption": "Премиум-линейка" }
          ]
        }
      }
    },

    "embed": {
      "description": "Встроенный контент: YouTube, Vimeo и др.",
      "schema": {
        "type": "embed",
        "data": {
          "service": "'youtube' | 'vimeo'",
          "source": "string (URL видео)",
          "caption": "string (подпись, опционально)"
        }
      },
      "example": {
        "type": "embed",
        "data": {
          "service": "youtube",
          "source": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
          "caption": "Обзор новинок Satisfyer 2026"
        }
      }
    },

    "faq": {
      "description": "Блок «вопрос-ответ» в формате аккордеона.",
      "schema": {
        "type": "faq",
        "data": {
          "items": [
            {
              "question": "string",
              "answer": "string (может содержать inline HTML)"
            }
          ]
        }
      },
      "example": {
        "type": "faq",
        "data": {
          "items": [
            {
              "question": "Какая минимальная сумма заказа?",
              "answer": "Минимальная сумма первого заказа — <b>15 000 ₽</b>. Для постоянных клиентов ограничений нет."
            },
            {
              "question": "Есть ли доставка в регионы?",
              "answer": "Да, доставляем по всей России через СДЭК, ПЭК и Деловые Линии. Срок — от 2 до 7 рабочих дней."
            },
            {
              "question": "Как стать партнёром?",
              "answer": "Зарегистрируйтесь на сайте, заполните данные о компании и оформите первый заказ. Персональный менеджер свяжется с вами в течение 24 часов."
            }
          ]
        }
      }
    }
  },

  "_fullExample": {

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_rop_decisions" targetNamespace="http://pecado.ru/bpmn">
<bpmn:process id="rop_decisions" name="Решения руководителя по управлению менеджерами" isExecutable="false">
<bpmn:startEvent id="s" name="Ежемесячный разбор результатов"><bpmn:outgoing>f_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="t1" name="Свести показатели: выполнение плана, база, долги, новые клиенты"><bpmn:incoming>f_1</bpmn:incoming><bpmn:outgoing>f_2</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g1" name="Выполнение плана ниже 60 %?"><bpmn:incoming>f_2</bpmn:incoming><bpmn:outgoing>f_3</bpmn:outgoing><bpmn:outgoing>f_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g2" name="Второй месяц подряд?"><bpmn:incoming>f_3</bpmn:incoming><bpmn:outgoing>f_5</bpmn:outgoing><bpmn:outgoing>f_6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t2" name="Закрыть кран: новые пакеты не выдавать, разобрать причины с менеджером"><bpmn:incoming>f_5</bpmn:incoming><bpmn:outgoing>f_7</bpmn:outgoing></bpmn:task>
<bpmn:task id="t3" name="Предупредить, включить в еженедельный контроль"><bpmn:incoming>f_6</bpmn:incoming><bpmn:outgoing>f_8</bpmn:outgoing></bpmn:task>
<bpmn:task id="t4" name="Кран открыт: менеджер участвует в раздаче пула"><bpmn:incoming>f_4</bpmn:incoming><bpmn:outgoing>f_9</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m1" name=""><bpmn:incoming>f_7</bpmn:incoming><bpmn:incoming>f_8</bpmn:incoming><bpmn:incoming>f_9</bpmn:incoming><bpmn:outgoing>f_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g3" name="Доля крупнейшего клиента выше 40 %?"><bpmn:incoming>f_10</bpmn:incoming><bpmn:outgoing>f_11</bpmn:outgoing><bpmn:outgoing>f_12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t5" name="Снизить концентрацию: выдать пул, задача на охват хвоста"><bpmn:incoming>f_11</bpmn:incoming><bpmn:outgoing>f_13</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m2" name=""><bpmn:incoming>f_12</bpmn:incoming><bpmn:incoming>f_13</bpmn:incoming><bpmn:outgoing>f_14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g4" name="Купили за 90 дней менее 60 % живой базы?"><bpmn:incoming>f_14</bpmn:incoming><bpmn:outgoing>f_15</bpmn:outgoing><bpmn:outgoing>f_16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t6" name="База велика для одного: передать часть клиентов или нанять человека"><bpmn:incoming>f_15</bpmn:incoming><bpmn:outgoing>f_17</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m3" name=""><bpmn:incoming>f_16</bpmn:incoming><bpmn:incoming>f_17</bpmn:incoming><bpmn:outgoing>f_18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g5" name="Есть свободные клиенты в общем списке?"><bpmn:incoming>f_18</bpmn:incoming><bpmn:outgoing>f_19</bpmn:outgoing><bpmn:outgoing>f_20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t7" name="Выдать пакет до 20 клиентов тем, у кого кран открыт"><bpmn:incoming>f_19</bpmn:incoming><bpmn:outgoing>f_21</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m4" name=""><bpmn:incoming>f_20</bpmn:incoming><bpmn:incoming>f_21</bpmn:incoming><bpmn:outgoing>f_22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g6" name="Сроки по выданным нарушены?"><bpmn:incoming>f_22</bpmn:incoming><bpmn:outgoing>f_23</bpmn:outgoing><bpmn:outgoing>f_24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t8" name="Вернуть клиента в общий список: нет контакта 10 дней или заказа 90 дней"><bpmn:incoming>f_23</bpmn:incoming><bpmn:outgoing>f_25</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m5" name=""><bpmn:incoming>f_24</bpmn:incoming><bpmn:incoming>f_25</bpmn:incoming><bpmn:outgoing>f_26</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t9" name="5-е число: утвердить ведомость, рассмотреть возражения"><bpmn:incoming>f_26</bpmn:incoming><bpmn:outgoing>f_27</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g7" name="Конец квартала?"><bpmn:incoming>f_27</bpmn:incoming><bpmn:outgoing>f_28</bpmn:outgoing><bpmn:outgoing>f_30</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t10" name="Рассчитать планы на три месяца по формуле, издать приказ"><bpmn:incoming>f_28</bpmn:incoming><bpmn:outgoing>f_29</bpmn:outgoing></bpmn:task>
<bpmn:task id="t11" name="Подвести квартальную премию отдела и распределить её"><bpmn:incoming>f_29</bpmn:incoming><bpmn:outgoing>f_31</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m6" name=""><bpmn:incoming>f_30</bpmn:incoming><bpmn:incoming>f_31</bpmn:incoming><bpmn:outgoing>f_32</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e" name="Цикл закрыт"><bpmn:incoming>f_32</bpmn:incoming></bpmn:endEvent>

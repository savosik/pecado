<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_manager_cycle" targetNamespace="http://pecado.ru/bpmn">
<bpmn:process id="manager_cycle" name="Рабочий цикл менеджера отдела продаж" isExecutable="false">
<bpmn:startEvent id="s" name="Начало рабочего дня"><bpmn:outgoing>f_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="t1" name="Открыть «Мой месяц»: доход, план, сколько до начала оплаты"><bpmn:incoming>f_1</bpmn:incoming><bpmn:outgoing>f_2</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g1" name="Оплата за базу уже началась?"><bpmn:incoming>f_2</bpmn:incoming><bpmn:outgoing>f_3</bpmn:outgoing><bpmn:outgoing>f_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t2" name="Дожать до начала оплаты: клиенты с наибольшим разрывом"><bpmn:incoming>f_3</bpmn:incoming><bpmn:outgoing>f_6</bpmn:outgoing></bpmn:task>
<bpmn:task id="t3" name="Наращивать сверх планки: каждый рубль даёт 1,9 копейки"><bpmn:incoming>f_4</bpmn:incoming><bpmn:outgoing>f_5</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m1" name=""><bpmn:incoming>f_5</bpmn:incoming><bpmn:incoming>f_6</bpmn:incoming><bpmn:outgoing>f_7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t4" name="Отработать обещания оплаты, назначенные на сегодня"><bpmn:incoming>f_7</bpmn:incoming><bpmn:outgoing>f_8</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g2" name="Есть долг старше 15 дней без движения?"><bpmn:incoming>f_8</bpmn:incoming><bpmn:outgoing>f_9</bpmn:outgoing><bpmn:outgoing>f_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t5" name="Передать долг руководителю с историей контактов"><bpmn:incoming>f_9</bpmn:incoming><bpmn:outgoing>f_11</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m2" name=""><bpmn:incoming>f_10</bpmn:incoming><bpmn:incoming>f_11</bpmn:incoming><bpmn:outgoing>f_12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t6" name="Пять и более результативных контактов по списку A2"><bpmn:incoming>f_12</bpmn:incoming><bpmn:outgoing>f_13</bpmn:outgoing></bpmn:task>
<bpmn:task id="t7" name="Записать контакты, обещания и задачи в CRM"><bpmn:incoming>f_13</bpmn:incoming><bpmn:outgoing>f_14</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g3" name="Сегодня понедельник?"><bpmn:incoming>f_14</bpmn:incoming><bpmn:outgoing>f_15</bpmn:outgoing><bpmn:outgoing>f_16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t8" name="Недельный блок: забытые клиенты, новые, фокус-товары, сроки по пулу"><bpmn:incoming>f_15</bpmn:incoming><bpmn:outgoing>f_17</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m3" name=""><bpmn:incoming>f_16</bpmn:incoming><bpmn:incoming>f_17</bpmn:incoming><bpmn:outgoing>f_18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g4" name="Какое сегодня число месяца?"><bpmn:incoming>f_18</bpmn:incoming><bpmn:outgoing>f_19</bpmn:outgoing><bpmn:outgoing>f_20</bpmn:outgoing><bpmn:outgoing>f_21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t9" name="1–5: сверить расчётный лист, при расхождении — возражение"><bpmn:incoming>f_19</bpmn:incoming><bpmn:outgoing>f_22</bpmn:outgoing></bpmn:task>
<bpmn:task id="t10" name="25–31: дожим по списку и контроль оформления заказов"><bpmn:incoming>f_20</bpmn:incoming><bpmn:outgoing>f_23</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m4" name=""><bpmn:incoming>f_21</bpmn:incoming><bpmn:incoming>f_22</bpmn:incoming><bpmn:incoming>f_23</bpmn:incoming><bpmn:outgoing>f_24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e" name="День закрыт"><bpmn:incoming>f_24</bpmn:incoming></bpmn:endEvent>
